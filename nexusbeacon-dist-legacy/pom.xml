<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>cl.dynasty</groupId><artifactId>nexusbeacon-parent</artifactId><version>1.3.0</version></parent>
    <artifactId>nexusbeacon-dist-legacy</artifactId>
    <name>NexusBeacon Legacy Foundation Distribution</name>
    <dependencies>
        <dependency><groupId>cl.dynasty</groupId><artifactId>nexusbeacon-platform-legacy</artifactId></dependency>
        <dependency><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId><scope>provided</scope></dependency>
    </dependencies>
    <build>
        <finalName>NexusBeacon-Legacy</finalName>
        <resources>
            <resource><directory>src/main/resources</directory><filtering>true</filtering></resource>
            <resource>
                <directory>${maven.multiModuleProjectDirectory}/src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>plugin.yml</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration><release>8</release></configuration></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration><createDependencyReducedPom>false</createDependencyReducedPom><artifactSet><excludes><exclude>org.spigotmc:spigot-api</exclude></excludes></artifactSet></configuration></execution></executions></plugin>
        </plugins>
    </build>
</project>
